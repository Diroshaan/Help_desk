# UNIHELP environment variables - template only. Never put real passwords in this file.
# Copy the values you need into your IntelliJ run configuration (Environment variables)
# or your shell. Spring Boot reads them from the environment; it does not load this file.

# MySQL connection (used with the "mysql" profile)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=helpdeskdb
MYSQL_USER=root
MYSQL_PASSWORD=change-me
# REQUIRED for a hosted database; PREFERRED for a local server without TLS
MYSQL_SSL_MODE=REQUIRED

# First administrator account, created on startup if none exists
HELPDESK_BOOTSTRAPADMIN_EMAIL=admin@helpdesk.local
HELPDESK_BOOTSTRAPADMIN_DISPLAYNAME=System Administrator
# Leave empty to have a random password printed once in the startup log
HELPDESK_BOOTSTRAPADMIN_PASSWORD=
